generator client {
  provider        = "prisma-client"
  output = "../generated/prisma"
  previewFeatures = ["typedSql", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

model User {
  id             Int           @id @default(autoincrement())
  username       String        @unique
  email          String        @unique
  name           String
  password       String
  role           Role          @default(USER)
  active         Boolean       @default(true)
  profilePic     String?
  biography      String?
  followingCount Int           @default(0)
  followersCount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  likes          Like[]
  posts          Post[]
  reposts        Repost[]
  saves          Save[]
  following      UserFollows[] @relation("Following")
  followers      UserFollows[] @relation("Followers")
  notifications      Notification[] @relation("NotificationRecipient")
  actorNotifications Notification[] @relation("NotificationActor")
}

model UserFollows {
  id          Int  @id @default(autoincrement())
  followerId  Int
  followingId Int
  follower    User @relation("Following", fields: [followerId], references: [id])
  following   User @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Post {
  id            Int      @id @default(autoincrement())
  postedById    Int
  parentPostId  Int?
  text          String?
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  repostsCount  Int      @default(0)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  images        String[]
  likes         Like[]
  parentPost    Post?    @relation("ParentPost", fields: [parentPostId], references: [id])
  childPosts    Post[]   @relation("ParentPost")
  postedBy      User     @relation(fields: [postedById], references: [id])
  reposts       Repost[]
  saves         Save[]
  notifications Notification[]

  // Trigram index so case-insensitive substring search (ILIKE '%term%') can use
  // an index instead of scanning every row.
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model Repost {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model Save {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

// Transactional outbox. An event row is written in the SAME transaction as the
// state change it describes (e.g. a like), so we never dual-write to Postgres
// and the message broker. A relay later publishes unpublished rows to Kafka and
// stamps publishedAt. The id is the event id that travels with the message and
// is the consumer's idempotency key.
model Outbox {
  id          String    @id @default(uuid())
  eventType   String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  // Find unpublished events in creation order for the relay to ship.
  @@index([publishedAt, createdAt])
}

// A derived view: the consequence of an event (someone liked your post or
// followed you). eventId is the originating Outbox id and is unique, so a
// redelivered event can't create a duplicate notification (idempotency).
model Notification {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique
  type        String
  recipientId Int
  actorId     Int
  postId      Int?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
  actor       User     @relation("NotificationActor", fields: [actorId], references: [id])
  post        Post?    @relation(fields: [postId], references: [id])

  // Serve a user's notifications newest-first.
  @@index([recipientId, createdAt])
}

enum Role {
  USER
  ADMIN
}
